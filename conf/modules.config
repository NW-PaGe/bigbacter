// ── Output subdirectories ────────────────────────────────────────────────────
def D = [
  reads:   'reads',
  qc:      'qc',
  asm:     'asm',
  taxa:    'taxa',
  cluster: 'cluster',
  var:     'var',
  recomb:  'recomb',
  aln:     'aln',
  tree:    'tree',
  summary: 'summary',
  dist:    'dist',
  report:  'reports'
]

// ── Shared closures ──────────────────────────────────────────────────────────
def samplePath  = { meta, subdir -> "${params.outdir}/${meta.timestamp}/${meta.id}/${subdir}" }
def clusterPath = { meta, subdir -> "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/${subdir}" }
def skipVersions = { fn -> fn == 'versions.yml' ? null : fn }
def OFF = [ enabled: false, path: { params.outdir } ]

process {

  // ── Global default ─────────────────────────────────────────────────────────
  tag = { set_tag(meta) }
  publishDir = [
    path:   { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
    mode:   params.publish_dir_mode,
    saveAs: skipVersions
  ]

  // ── Initialize ─────────────────────────────────────────────────────────────
  withName: 'TIMESTAMP' {
    container  = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    publishDir = OFF
  }

  // ── Per-sample ─────────────────────────────────────────────────────────────
  withName: 'FASTERQDUMP' {
    ext.args   = '-S'
    container  = 'quay.io/biocontainers/mulled-v2-5f89fe0cd045cb1d615630b9261a1d17943a9b6a:2f4a4c900edd6801ff0068c2b3048b4459d119eb-0'
    publishDir = [ path: { samplePath(meta, D.reads) }, pattern: "*.gz", mode: params.publish_dir_mode ]
  }
  withName: 'NCBI_DATASETS' {
    container  = 'docker.io/staphb/ncbi-datasets:18.18.0'
    publishDir = [ path: { samplePath(meta, D.asm) }, pattern: "contigs.fa", saveAs: { "${meta.id}.fa" }, mode: params.publish_dir_mode ]
  }
  withName: 'FASTQC' {
    ext.args   = "--quiet"
    publishDir = OFF
  }
  withName: 'FASTP' {
    publishDir = OFF
  }
  withName: 'SHOVILL' {
    container  = "docker.io/staphb/shovill:1.4.2"
    publishDir = [ path: { samplePath(meta, D.asm) }, pattern: "contigs.fa", saveAs: { "${meta.id}.fa" }, mode: params.publish_dir_mode ]
  }
  withName: 'STD_ASSEMBLY' {
    container  = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    publishDir = OFF
  }
  withName: 'GAMBIT_QUERY' {
    publishDir = [ path: { samplePath(meta, D.taxa) }, saveAs: skipVersions, mode: params.publish_dir_mode ]
  }

  // ── Per-cluster ────────────────────────────────────────────────────────────
  withName: 'FLOC' {
    ext.args   = "--ksize 31 --scaled 100 --batch 1000"
    container  = 'public.ecr.aws/o8h2f0o1/floc:1.0.1'
    publishDir = [ path: { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${D.cluster}" }, pattern: "*.{csv,sig}", mode: params.publish_dir_mode ]
  }
  withName: 'SELECT_REF' {
    container  = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    publishDir = OFF
  }
  withName: 'DS_RATE' {
    container  = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    publishDir = OFF
  }
  withName: 'SNIPPY_SINGLE' {
    container  = 'public.ecr.aws/o8h2f0o1/snippy:4.6.0-SC2'
    ext.args   = '--cleanup'
    publishDir = [ path: { clusterPath(meta, D.var) }, pattern: "*.tar.gz", mode: 'copy' ]
  }
  withName: 'SNIPPY_CORE' {
    container  = 'public.ecr.aws/o8h2f0o1/snippy:4.6.0-SC2'
    publishDir = OFF
  }
  withName: 'GUBBINS' {
    container   = "docker.io/staphb/gubbins:3.4.1"
    stageInMode = 'copy'
    publishDir  = [
      [ pattern: "*.{vcf,bed}",                 path: { clusterPath(meta, D.recomb) }, saveAs: { fn -> update_filename(fn, meta) },                                       mode: 'copy' ],
      [ pattern: "*.per_branch_statistics.csv", path: { clusterPath(meta, D.recomb) }, saveAs: { fn -> update_filename(fn, meta, suffix="per_branch_statistics.csv") },   mode: 'copy' ]
    ]
  }
  withName: 'POLYCORE' {
    container  = 'public.ecr.aws/o8h2f0o1/polycore:1.0.0'
    ext.args   = "--progressive --ploidy 1 --snippy"
    publishDir = [
      [ pattern: 'core.aln',      path: { clusterPath(meta, D.aln) }, saveAs: { fn -> update_filename(fn, meta) } ],
      [ pattern: 'core.full.aln', path: { clusterPath(meta, D.aln) }, saveAs: { fn -> update_filename(fn, meta, label="_full") } ],
      [ pattern: 'full.csv',      path: { clusterPath(meta, D.aln) }, saveAs: { fn -> update_filename(fn, meta, label="_full") } ],
      [ pattern: '*.html',        path: { clusterPath(meta, D.qc) },  saveAs: { fn -> update_filename(fn, meta, label="_cg-plot") } ]
    ]
  }
  withName: 'IQTREE' {
    container   = "docker.io/staphb/iqtree2:2.4.0"
    stageInMode = 'copy'
    publishDir  = OFF
  }
  withName: 'CLUSTER' {
    container  = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    publishDir = [
      [ pattern: '*.nwk',        path: { clusterPath(meta, D.tree) } ],
      [ pattern: '*_summary.*',  path: { clusterPath(meta, D.summary) } ],
      [ pattern: '*-dist.*',     path: { clusterPath(meta, D.dist) } ],
      [ pattern: '*.microreact', path: { clusterPath(meta, D.report) } ]
    ]
  }

  // ── DB writes ──────────────────────────────────────────────────────────────
  withName: 'TAXA_FILES' {
    stageInMode = 'copy'
    container   = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
      publishDir = [
        [ pattern: '*.sig.gz',  path: { "${params.db}/${meta.taxa}/sig/" }, mode: 'copy' ]
      ]
  }
  withName: 'CLUSTER_FILES' {
    stageInMode = 'copy'
    container   = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
      publishDir = [
        [ pattern: '*.fa.gz',   path: { "${params.db}/${meta.taxa}/clusters/${meta.cluster}/asm/" }, mode: 'copy' ],
        [ pattern: '*.tar.gz',  path: { "${params.db}/${meta.taxa}/clusters/${meta.cluster}/var/" }, mode: 'copy' ],
        [ pattern: '*.json.gz', path: { "${params.db}/${meta.taxa}/clusters/${meta.cluster}/aux/" }, mode: 'copy' ]
      ]
  }

  withName: 'MULTIQC' {
    ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
    publishDir = [ path: { "${params.outdir}/${timestamp}/multiqc" }, pattern: "multiqc_report.html", mode: params.publish_dir_mode ]
  }
}

// ── Helper functions ─────────────────────────────────────────────────────────
def update_filename(fn, meta, label=null, suffix=null) {
  def prefix = [meta.timestamp, meta.taxa, meta.cluster].findAll().join('-')
  suffix = suffix ?: fn.tokenize('.').last()
  return [prefix, label, meta.recomb_masked ? ".masked." : ".", suffix].findAll().join()
}

def set_tag(meta) {
  if (meta.containsKey('id')) {
    return meta.id
  }
  return [meta.taxa, meta.cluster, meta.recomb_masked ? '[masked]' : null].findAll().join(' ')
}