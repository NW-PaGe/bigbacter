/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Config file for defining DSL2 per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Available keys to override module options:
    ext.args   = Additional arguments appended to command in module.
    ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
    ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
    ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

  /*
   * Default publishDir for all processes.
   * - Routes to: <outdir>/<process_group> where process_group is derived from task.process
   * - Skips versions.yml everywhere by default
   */
  publishDir = [
    path:   { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
    mode:   params.publish_dir_mode,
    saveAs: { fn -> fn == 'versions.yml' ? null : fn }
  ]
  withName: 'TIMESTAMP' {
    container = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    publishDir = [
      enabled: false
    ]
  }
  withName: 'FASTERQDUMP' {
    ext.args = '-S'
    publishDir = [
      path:    { "${params.outdir}/${meta.timestamp}/${meta.id}/reads" },
      pattern: "*.gz"
    ]
  }
  withName: 'SEQTK_SAMPLE' {
    ext.args = ""
    publishDir = [ enabled: false ]
  }

  withName: 'FASTQC' {
    ext.args = "--quiet"
    publishDir = [
      enabled: true,
      mode:    params.publish_dir_mode,
      path:    { "${params.outdir}/${meta.timestamp}/${meta.id}/qc" },
      pattern: "*.html"
    ]
  }
  withName: 'FASTP' {
    ext.args = ""
    publishDir = [
      enabled: true,
      mode:    params.publish_dir_mode,
      path:    { "${params.outdir}/${meta.timestamp}/${meta.id}/qc" },
      pattern: "*.json"
    ]
  }
  withName: 'STD_ASSEMBLY' {
    container = "public.ecr.aws/o8h2f0o1/pigz:2.8"
    ext.args = ""
    publishDir = [ enabled: false ]
  }
  withName: 'SHOVILL' {
    container = "docker.io/staphb/shovill:1.4.2"
    ext.args = ""
    publishDir = [
      enabled: true,
      mode:    params.publish_dir_mode,
      path:    { "${params.outdir}/${meta.timestamp}/${meta.id}/assembly" },
      pattern: "contigs.fa",
      saveAs:  { fn -> "${meta.id}.fa" }
    ]
  }
  withName: 'GAMBIT_QUERY' {
    ext.args = ""
    publishDir = [
      enabled: true,
      mode:    params.publish_dir_mode,
      path:    { "${params.outdir}/${meta.timestamp}/${meta.id}/taxa" }
    ]
  }

  withName: 'FLOC' {
    ext.args = "--ksize 31 --scaled 100 --batch 1000"
    tag = { set_tag(meta) }
    container = 'public.ecr.aws/o8h2f0o1/floc:1.0.0'
    publishDir = [
      enabled: true,
      mode:    params.publish_dir_mode,
      path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/cluster" }    
    ]
  }

  withName: 'SELECT_REF' {
    tag = { set_tag(meta) }
    container = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    ext.args = ""
    publishDir = [ enabled: false ]
  }

  withName: 'DS_RATE' {
    container = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    tag = { set_tag(meta) }
    ext.args = ""
    publishDir = [
      mode: params.publish_dir_mode,
      path: { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}" }
    ]
  }

  withName: 'SNIPPY_SINGLE' {
    container = 'public.ecr.aws/o8h2f0o1/snippy:4.6.0-SC2'
    ext.args  = '--cleanup'
    publishDir = [
      path: { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/var" },
      mode: 'copy'
      // saveAs inherited from default (skips versions.yml)
    ]
  }
  withName: 'SNIPPY_CORE' {
    tag = { set_tag(meta) }
    container = 'public.ecr.aws/o8h2f0o1/snippy:4.6.0-SC2'
    publishDir = [
      path: { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/var" },
      mode: 'copy'
    ]
  }
  withName: 'GUBBINS' {
    tag = { set_tag(meta) }
    container   = "docker.io/staphb/gubbins:3.4.1"
    ext.args    = ""
    stageInMode = 'copy'

    publishDir = [
      [
        pattern: "*.{vcf,bed}",
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/recomb" },
        saveAs:  { fn -> update_filename(fn, meta) },
        mode:    'copy'
      ],
      [
        pattern: "*.per_branch_statistics.csv",
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/recomb" },
        saveAs:  { fn -> update_filename(fn, meta, suffix="per_branch_statistics.csv") },
        mode:    'copy'
      ]
    ]
  }
  withName: 'POLYCORE' {
    tag = { set_tag(meta) }
    container = 'public.ecr.aws/o8h2f0o1/polycore:1.0.0'
    ext.args  = "--progressive --ploidy 1 --snippy"

    // Multiple publish rules -> list of maps
    publishDir = [
      [
        pattern: 'core.aln',
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/aln" },
        saveAs:  { fn -> update_filename(fn, meta) }
      ],
      [
        pattern: 'core.full.aln',
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/aln" },
        saveAs:  { fn -> update_filename(fn, meta, tag="_full") }
      ],
      [
        pattern: 'full.csv',
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/vcf" },
        saveAs:  { fn -> update_filename(fn, meta) }
      ],
      [
        pattern: '*.html',
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/qc" },
        saveAs:  { fn -> update_filename(fn, meta, tag="_cg-plot") }
      ]
    ]
  }
  withName: 'IQTREE' {
    tag = { set_tag(meta) }
    container   = "docker.io/staphb/iqtree2:2.4.0"
    ext.args    = ""
    stageInMode = 'copy'
    publishDir  = [ enabled: false ]
  }

  withName: 'CLUSTER' {
    tag = { set_tag(meta) }
    container = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    publishDir = [
      [
        pattern: '*.nwk',
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/tree" }
      ],
      [
        pattern: '*_summary.*',
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/summary" }
      ],
      [
        pattern: '*-dist.*',
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/dist" }
      ],
      [
        pattern: '*.microreact',
        path:    { "${params.outdir}/${meta.timestamp}/${meta.taxa}/${meta.cluster}/report" }
      ]
    ]
  }

  withName: 'FILES' {
    tag = { set_tag(meta) }
    stageInMode = 'copy'
    container = 'public.ecr.aws/o8h2f0o1/bigbacter:2.0'
    publishDir = [
      [
        pattern: '*.fa.gz',
        path:    { "${params.db}/${meta.taxa}/clusters/${meta.cluster}/asm/" },
        mode: 'copy',
        saveAs: { fn -> fn ? fn.tokenize('/').last() : null }
      ],
      [
        pattern: '*.tar.gz',
        path:    { "${params.db}/${meta.taxa}/clusters/${meta.cluster}/var/" },
        mode: 'copy',
        saveAs: { fn -> fn ? fn.tokenize('/').last() : null }
      ],
      [
        pattern: '*.json.gz',
        path:    { "${params.db}/${meta.taxa}/clusters/${meta.cluster}/aux/" },
        mode: 'copy',
        saveAs: { fn -> fn ? fn.tokenize('/').last() : null }
      ],
      [
        pattern: '*.sig.gz',
        path:    { "${params.db}/${meta.taxa}/sig/" },
        mode: 'copy',
        saveAs: { fn -> fn ? fn.tokenize('/').last() : null }
      ]
    ]
  }

  withName: 'MULTIQC' {
    ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
    publishDir = [
      path: { "${params.outdir}/${timestamp}/multiqc" }, 
      mode: params.publish_dir_mode
      // saveAs inherited from default (skips versions.yml)
    ]
  }
}

def update_filename(fn, meta, tag=None, suffix=None) {

        def prefix = [meta.timestamp, meta.taxa, meta.cluster].findAll().join('-')
        suffix = suffix ? suffix : fn.tokenize('.').last()

        return [prefix, tag, meta.recomb_masked ? ".masked." : ".", suffix ].findAll().join()
}

def set_tag(meta){
    return [ meta.taxa, meta.cluster, meta.recomb_masked ? '[masked]' : null ].findAll().join(' ')
}
